# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Claude Code settings/permission allowlist can end up holding raw
# tokens/passwords from approved commands (2026-07-23) - never share this.
.claude/settings.local.json

# Photos captured on-device during Split IBLPN testing - local test data,
# not source.
/captured_images/

# Customer-locked builds from tools/generate_customer_build.py (Android
# APK + Windows zip) - these have live OAuth client_id/client_secret
# compiled in, must never be committed.
/customer_builds/

# Stable, persistent copy of the plain unlocked daily-dev Windows build -
# the desktop shortcut points here, not into /build/, specifically so
# running generate_customer_build.py can never again silently overwrite it
# (real incident, 2026-07-26 - both used to write to the same build/
# output folder).
/dev_build/
